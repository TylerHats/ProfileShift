<Window x:Class="ProfileShift.UI.Views.FolderPickerModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Granular Folder Selection - ProfileShift" Height="580" Width="520"
        Background="#2F3136" Foreground="#D9D9D9"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="📁 Customize Subfolders and Directories" 
                       Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="Select or deselect specific folders and subdirectories to include in your backup. Unchecked subfolders will be explicitly excluded." 
                       Foreground="#B9BBBE" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#36393F" CornerRadius="6" Padding="8">
            <TreeView x:Name="TvFolders" Background="Transparent" BorderThickness="0"
                      VirtualizingStackPanel.IsVirtualizing="True">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Foreground" Value="#D9D9D9"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                      IsThreeState="True" 
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding DisplayIcon}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" Foreground="#D9D9D9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- Quick selection helper buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnSelectAll" Content="Select All" Height="26" Width="85" Background="#40444B" Foreground="#D9D9D9" Click="BtnSelectAll_Click" Margin="0,0,6,0"/>
            <Button x:Name="BtnDeselectAll" Content="Deselect All" Height="26" Width="95" Background="#40444B" Foreground="#D9D9D9" Click="BtnDeselectAll_Click" Margin="0,0,6,0"/>
            <Button x:Name="BtnExpandAll" Content="Expand All" Height="26" Width="85" Background="#40444B" Foreground="#D9D9D9" Click="BtnExpandAll_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnConfirm" Content="Confirm" Width="95" Height="32" Background="#7289DA" Foreground="White" FontWeight="Bold" Click="BtnConfirm_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="95" Height="32" Background="#40444B" Foreground="White" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

