<Window x:Class="ProfileShift.UI.Views.FolderPickerModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Granular Folder Selection - ProfileShift" Height="500" Width="450"
        Background="#2F3136" Foreground="#D9D9D9"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select specific folders and subdirectories to back up:" 
                   Foreground="#D9D9D9" Margin="0,0,0,10" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Background="#36393F" CornerRadius="6" Padding="6">
            <TreeView x:Name="TvFolders" Background="Transparent" BorderThickness="0">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="#D9D9D9"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnConfirm" Content="Confirm" Width="90" Height="32" Background="#7289DA" Foreground="White" FontWeight="Bold" Click="BtnConfirm_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="32" Background="#40444B" Foreground="White" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
