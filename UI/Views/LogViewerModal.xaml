<Window x:Class="ProfileShift.UI.Views.LogViewerModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Viewer - ProfileShift" Height="550" Width="700"
        Background="#2F3136" Foreground="#D9D9D9"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search & Filters -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch" Grid.Column="0" Height="28" Padding="4" Background="#40444B" Foreground="#D9D9D9" TextChanged="TxtSearch_TextChanged"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <CheckBox x:Name="ChkInfo" Content="Info" IsChecked="True" Foreground="#D9D9D9" Margin="4,4,8,4" Click="Filter_Click"/>
                <CheckBox x:Name="ChkWarning" Content="Warning" IsChecked="True" Foreground="#E67E22" Margin="4,4,8,4" Click="Filter_Click"/>
                <CheckBox x:Name="ChkError" Content="Error" IsChecked="True" Foreground="#E74C3C" Margin="4,4,0,4" Click="Filter_Click"/>
            </StackPanel>
        </Grid>

        <!-- Log List -->
        <Border Grid.Row="1" Background="#36393F" CornerRadius="6" Padding="6">
            <DataGrid x:Name="DgLogs" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" RowBackground="#36393F" AlternatingRowBackground="#2F3136" Foreground="#D9D9D9" GridLinesVisibility="None" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="140"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnExportTxt" Content="Export to TXT" Width="110" Height="32" Background="#40444B" Foreground="White" Click="BtnExportTxt_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnClose" Content="Close" Width="90" Height="32" Background="#7289DA" Foreground="White" FontWeight="Bold" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
