<Window x:Class="ProfileShift.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hat's ProfileShift" Height="780" Width="520" Icon="pack://application:,,,/ProfileShiftIcon.ico"
        Background="#2F3136" Foreground="#D9D9D9"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#36393F"/>
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="BorderBrush" Value="#40444B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#40444B"/>
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="BorderBrush" Value="#202225"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Tabs -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBackupTab" Grid.Column="0" Content="Backup (Export)" Height="38" Background="#36393F" FontWeight="Bold" Click="BtnBackupTab_Click"/>
            <Button x:Name="BtnRestoreTab" Grid.Column="1" Content="Restore (Import)" Height="38" Background="#2F3136" Foreground="#808080" Click="BtnRestoreTab_Click"/>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Backup Tab Panel -->
            <Border x:Name="PanelBackup" Background="#36393F" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Destination Folder:" Foreground="#D9D9D9" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtBackupPath" Grid.Column="0" Height="28"/>
                            <Button x:Name="BtnBrowseBackup" Grid.Column="1" Content="Browse" Width="70" Height="28" Margin="6,0,0,0" Click="BtnBrowseBackup_Click"/>
                        </Grid>
                        <TextBlock x:Name="LblMediaWarning" Text="" Foreground="#43B581" Margin="0,0,0,10" FontWeight="SemiBold"/>

                        <TextBlock Text="Select Users to Migrate:" Foreground="#D9D9D9" Margin="0,0,0,4"/>
                        <Border Background="#40444B" CornerRadius="4" Padding="6" Height="100" Margin="0,0,0,10">
                            <ListBox x:Name="LstUsers" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Username}" IsChecked="{Binding IsSelected}" Foreground="#D9D9D9"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Text="Options &amp; Folders:" Foreground="#D9D9D9" FontWeight="Bold" Margin="0,5,0,5"/>
                        <CheckBox x:Name="ChkRootData" Content="Include Non-Standard C:\ Root Folders" IsChecked="True"/>
                        <CheckBox x:Name="ChkUserProfiles" Content="User Profile Directories (Desktop, Docs, Downloads)" IsChecked="True"/>
                        <CheckBox x:Name="ChkBrowsers" Content="Browser Profiles (Chrome, Edge, Firefox, Opera, Brave)" IsChecked="True"/>
                        <CheckBox x:Name="ChkSettings" Content="OS Settings, Wallpaper, Taskbar &amp; Printers" IsChecked="True"/>
                        <CheckBox x:Name="ChkSoftware" Content="Generate Software Inventory Report" IsChecked="True"/>
                        <CheckBox x:Name="ChkIntegrity" Content="Perform File Integrity Verification" IsChecked="True"/>
                        <Button x:Name="BtnCustomizeFolders" Content="Customize Subfolders (Tree View)..." Height="28" Margin="0,6,0,6" Background="#40444B" Click="BtnCustomizeFolders_Click"/>

                        <TextBlock x:Name="LblLiveEstimate" Text="Selected: Calculating..." Foreground="#43B581" FontWeight="SemiBold" Margin="0,6,0,4"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnStartBackup" Grid.Column="0" Content="Start Backup" Height="36" Background="#7289DA" Foreground="White" FontWeight="Bold" Click="BtnStartBackup_Click"/>
                            <Button x:Name="BtnCancelBackup" Grid.Column="1" Content="Cancel" Width="80" Height="36" Background="#B33232" Foreground="White" IsEnabled="False" Margin="6,0,0,0" Click="BtnCancelBackup_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Restore Tab Panel -->
            <Border x:Name="PanelRestore" Background="#36393F" CornerRadius="6" Padding="12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Backup Source Folder:" Foreground="#D9D9D9" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtRestorePath" Grid.Column="0" Height="28" TextChanged="TxtRestorePath_TextChanged"/>
                        <Button x:Name="BtnBrowseRestore" Grid.Column="1" Content="Browse" Width="70" Height="28" Margin="6,0,0,0" Click="BtnBrowseRestore_Click"/>
                    </Grid>

                    <TextBlock Text="Users Available in Backup:" Foreground="#D9D9D9" Margin="0,0,0,4"/>
                    <Border Background="#40444B" CornerRadius="4" Padding="6" Height="140" Margin="0,0,0,15">
                        <ListBox x:Name="LstRestoreUsers" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}" Foreground="#D9D9D9" IsChecked="True"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Button x:Name="BtnStartRestore" Content="Stage Migration Data" Height="40" Background="#7289DA" Foreground="White" FontWeight="Bold" Click="BtnStartRestore_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Grid Margin="0,0,0,4">
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#D9D9D9" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtTelemetry" Text="" Foreground="#43B581" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="BtnViewLogs" Content="View Logs..." Height="24" Width="90" Background="#40444B" Click="BtnViewLogs_Click"/>
                </StackPanel>
            </Grid>
            <ProgressBar x:Name="MainProgressBar" Height="12" Background="#40444B" Foreground="#43B581" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtLog" Height="100" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#202225" Foreground="#D9D9D9" FontFamily="Consolas" FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
