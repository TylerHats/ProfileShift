<Window x:Class="ProfileShift.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hat's ProfileShift" Height="820" Width="540" Icon="pack://application:,,,/ProfileShiftIcon.ico"
        Background="#2F3136" Foreground="#D9D9D9"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Tabs -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBackupTab" Grid.Column="0" Content="Backup (Export)" Height="38" Background="#36393F" FontWeight="Bold" Click="BtnBackupTab_Click"/>
            <Button x:Name="BtnRestoreTab" Grid.Column="1" Content="Restore (Import)" Height="38" Background="#2F3136" Foreground="#808080" Click="BtnRestoreTab_Click"/>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Backup Tab Panel -->
            <Border x:Name="PanelBackup" Background="#36393F" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,4,0">
                            <!-- Section 1: Destination & Users -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock Text="📁 Destination &amp; User Accounts" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13.5"/>
                                </Expander.Header>
                                <StackPanel Margin="2,4,2,2">
                                    <TextBlock Text="Destination Folder:" Foreground="#D9D9D9" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtBackupPath" Grid.Column="0" Height="28"/>
                                        <Button x:Name="BtnBrowseBackup" Grid.Column="1" Content="Browse" Width="70" Height="28" Margin="6,0,0,0" Click="BtnBrowseBackup_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="LblMediaWarning" Text="" Foreground="#43B581" Margin="0,0,0,8" FontWeight="SemiBold"/>

                                    <TextBlock Text="Select Users to Migrate:" Foreground="#D9D9D9" Margin="0,0,0,4"/>
                                    <Border Background="#40444B" CornerRadius="4" Padding="6" Height="95" Margin="0,0,0,4">
                                        <ListBox x:Name="LstUsers" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Username}" IsChecked="{Binding IsSelected}" Foreground="#D9D9D9"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- Section 2: Migration Options & Folders -->
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock Text="⚙️ Migration Options &amp; Folders" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13.5"/>
                                </Expander.Header>
                                <StackPanel Margin="2,4,2,2">
                                    <CheckBox x:Name="ChkRootData" Content="Include Non-Standard C:\ Root Folders" IsChecked="True"/>
                                    <CheckBox x:Name="ChkUserProfiles" Content="User Profile Directories (Desktop, Docs, Downloads)" IsChecked="True"/>
                                    <CheckBox x:Name="ChkBrowsers" Content="Browser Profiles (Chrome, Edge, Firefox, Opera, Brave)" IsChecked="True"/>
                                    <CheckBox x:Name="ChkSettings" Content="OS Settings, Wallpaper, Taskbar &amp; Printers" IsChecked="True"
                                              Checked="ElevationOption_Changed" Unchecked="ElevationOption_Changed"/>
                                    <CheckBox x:Name="ChkSoftware" Content="Generate Software Inventory Report" IsChecked="True"/>
                                    <CheckBox x:Name="ChkIntegrity" Content="Perform File Integrity Verification" IsChecked="True"/>

                                    <Button x:Name="BtnCustomizeFolders" Content="Customize Subfolders (Tree View)..." Height="28" Margin="0,8,0,2" Background="#40444B" Click="BtnCustomizeFolders_Click"/>
                                </StackPanel>
                            </Expander>

                            <!-- Section 3: Credential Migration -->
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="🔐 Credential &amp; Password Migration" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13.5"/>
                                </Expander.Header>
                                <StackPanel Margin="2,4,2,2">
                                    <CheckBox x:Name="ChkCredentialManager" Content="Credential Manager (RDP, Drives, VPN Passwords)" IsChecked="False"
                                              Checked="CredentialOption_Changed" Unchecked="CredentialOption_Changed"/>
                                    <CheckBox x:Name="ChkBrowserPasswords" Content="Browser Saved Passwords (Chrome, Edge, Brave, Vivaldi)" IsChecked="False"
                                              Checked="CredentialOption_Changed" Unchecked="CredentialOption_Changed"/>

                                    <!-- Password Export Warning Banner -->
                                    <Border x:Name="PasswordWarningBanner" Background="#33FFA500" CornerRadius="4" Padding="8" Margin="0,6,0,2" Visibility="Collapsed">
                                        <TextBlock TextWrapping="Wrap" Foreground="#FFD580" FontSize="11.5">
                                            ⚠️ You will be prompted to set a passphrase to encrypt exported credentials. You'll need this same passphrase when restoring on the target machine. Ensure your backup destination is secure.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Action Bar inside Backup Panel -->
                    <Border Grid.Row="1" Background="#202225" CornerRadius="4" Padding="8" Margin="0,4,0,6">
                        <TextBlock x:Name="LblLiveEstimate" Text="Selected: Calculating..." Foreground="#43B581" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnStartBackup" Grid.Column="0" Height="36" Background="#7289DA" Foreground="White" Click="BtnStartBackup_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UacShieldBackup" Text="🛡️ " FontSize="14" Visibility="Collapsed" VerticalAlignment="Center"/>
                                <TextBlock Text="Start Backup" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnCancelBackup" Grid.Column="1" Content="Cancel" Width="80" Height="36" Background="#B33232" Foreground="White" IsEnabled="False" Margin="6,0,0,0" Click="BtnCancelBackup_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Restore Tab Panel -->
            <Border x:Name="PanelRestore" Background="#36393F" CornerRadius="6" Padding="12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Backup Source Folder:" Foreground="#D9D9D9" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtRestorePath" Grid.Column="0" Height="28" TextChanged="TxtRestorePath_TextChanged"/>
                        <Button x:Name="BtnBrowseRestore" Grid.Column="1" Content="Browse" Width="70" Height="28" Margin="6,0,0,0" Click="BtnBrowseRestore_Click"/>
                    </Grid>

                    <TextBlock Text="Users Available in Backup:" Foreground="#D9D9D9" Margin="0,0,0,4"/>
                    <Border Background="#40444B" CornerRadius="4" Padding="6" Height="120" Margin="0,0,0,10">
                        <ListBox x:Name="LstRestoreUsers" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}" Foreground="#D9D9D9" IsChecked="True"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Restore credential info -->
                    <TextBlock x:Name="LblRestoreCredentialInfo" Text="" Foreground="#43B581" FontWeight="SemiBold" 
                               TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <Button x:Name="BtnStartRestore" Height="40" Background="#7289DA" Foreground="White" Click="BtnStartRestore_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UacShieldRestore" Text="🛡️ " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Stage Migration Data" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status & Log Output -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Grid Margin="0,0,0,4">
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#D9D9D9" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtTelemetry" Text="" Foreground="#43B581" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="BtnViewLogs" Content="View Logs..." Height="24" Width="90" Background="#40444B" Click="BtnViewLogs_Click"/>
                </StackPanel>
            </Grid>
            <ProgressBar x:Name="MainProgressBar" Height="12" Background="#40444B" Foreground="#43B581" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtLog" Height="100" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#202225" Foreground="#D9D9D9" FontFamily="Consolas" FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
